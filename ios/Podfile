# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, '16.0'
prepare_react_native_project!

# Six build configurations: Debug/Release × Dev/Staging/Prod (see scripts/ios-configure.rb).
project 'Lagnaa',
  'Debug-Dev' => :debug, 'Release-Dev' => :release,
  'Debug-Staging' => :debug, 'Release-Staging' => :release,
  'Debug-Prod' => :debug, 'Release-Prod' => :release

# React Native Firebase: static frameworks via CocoaPods (its default SPM resolution does not support static linkage).
$RNFirebaseDisableSPM = true
use_frameworks! :linkage => :static
$RNFirebaseAsStaticFramework = true

ENV_FILE_BY_CONFIGURATION = {
  'Debug-Dev' => 'env/.env.development', 'Release-Dev' => 'env/.env.development',
  'Debug-Staging' => 'env/.env.staging', 'Release-Staging' => 'env/.env.staging',
  'Debug-Prod' => 'env/.env.production', 'Release-Prod' => 'env/.env.production',
}

target 'Lagnaa' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |bc|
        bc.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '16.0'
        # react-native-config reads ENVFILE at build time; map it from the app configuration.
        env_file = ENV_FILE_BY_CONFIGURATION[bc.name]
        bc.build_settings['ENVFILE'] = env_file if env_file && target.name == 'react-native-config'
      end
    end
  end
end
