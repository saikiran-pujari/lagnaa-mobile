{
  "name": "lagnaa-mobile",
  "version": "1.1.0",
  "private": true,
  "description": "Lagnaa native mobile app (React Native 0.87, New Architecture)",
  "license": "UNLICENSED",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "react-native start",
    "android:dev": "react-native run-android --mode devDebug --appId in.lagnaa.app.dev",
    "android:staging": "react-native run-android --mode stagingDebug --appId in.lagnaa.app.staging",
    "android:prod": "react-native run-android --mode prodDebug --appId in.lagnaa.app",
    "android:bundle:prod": "cd android && ./gradlew bundleProdRelease",
    "ios:dev": "react-native run-ios --scheme Lagnaa-Dev --mode Debug-Dev",
    "ios:staging": "react-native run-ios --scheme Lagnaa-Staging --mode Debug-Staging",
    "ios:prod": "react-native run-ios --scheme Lagnaa --mode Debug-Prod",
    "pods": "cd ios && pod install",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest",
    "test:unit": "jest tests/unit",
    "test:component": "jest tests/component",
    "test:e2e": "maestro test tests/e2e",
    "env:check": "node scripts/env-check.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "fingerprint": "node scripts/fingerprint.mjs",
    "sync-version": "node scripts/sync-version.mjs",
    "validate": "pnpm env:check && pnpm lint && pnpm typecheck && pnpm format:check && pnpm test"
  },
  "dependencies": {
    "@react-native-firebase/app": "26.4.0",
    "@react-native-firebase/database": "26.4.0",
    "@react-native-firebase/messaging": "26.4.0",
    "@react-native-google-signin/google-signin": "16.1.5",
    "@react-navigation/bottom-tabs": "7.20.0",
    "@react-navigation/native": "7.5.0",
    "@react-navigation/native-stack": "7.20.0",
    "@sentry/react-native": "8.30.0",
    "@shopify/flash-list": "2.3.3",
    "@tanstack/query-sync-storage-persister": "5.104.2",
    "@tanstack/react-query": "5.104.2",
    "@tanstack/react-query-persist-client": "5.104.2",
    "lucide-react-native": "1.55.0",
    "react": "19.2.3",
    "react-native": "0.87.1",
    "react-native-bootsplash": "7.3.4",
    "react-native-config": "1.7.2",
    "react-native-gesture-handler": "3.3.0",
    "react-native-keychain": "10.0.0",
    "react-native-mmkv": "4.3.2",
    "react-native-nitro-modules": "0.37.1",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "5.10.1",
    "react-native-screens": "4.29.0",
    "react-native-svg": "15.15.5",
    "react-native-worklets": "0.13.0",
    "zod": "4.6.6",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/plugin-transform-export-namespace-from": "^7.29.7",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.87.1",
    "@react-native/eslint-config": "0.87.1",
    "@react-native/jest-preset": "0.87.1",
    "@react-native/metro-config": "0.87.1",
    "@react-native/typescript-config": "0.87.1",
    "@testing-library/react-native": "14.1.0",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "babel-plugin-module-resolver": "5.0.3",
    "babel-plugin-transform-remove-console": "6.9.4",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "eslint-plugin-unused-imports": "4.4.1",
    "jest": "^29.6.3",
    "prettier": "3.9.10",
    "react-test-renderer": "19.2.3",
    "sharp": "^0.35.5",
    "test-renderer": "1.3.1",
    "tsx": "4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.71.1"
  }
}
